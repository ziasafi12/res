{
  "name": "shahjee-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
"scripts": {
  "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
  "dev:server": "node server/src/server.js",
  "dev:client": "vite",
  "build": "npm install --prefix server && vite build",
  "preview": "vite preview",
  "start": "node server/src/server.js",
  "start:server": "node server/src/server.js",
  "migrate": "node server/migrate.js",
  "seed": "node server/seed.js",
  "test:api": "node server/integration-test.js"
},

  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
